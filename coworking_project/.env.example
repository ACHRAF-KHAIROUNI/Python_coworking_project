# ==========================================
# Configuration de l'environnement (Exemple)
# Renommez ce fichier en '.env' et complétez les valeurs
# ==========================================

# Clé secrète Django
SECRET_KEY=votre_cle_secrete_django_ici
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Configuration Email (SMTP)
EMAIL_HOST_USER=votre_email@gmail.com
EMAIL_HOST_PASSWORD=votre_mot_de_passe_application

# Base de données PostgreSQL (ex: Supabase, Azure, Neon ou Local)
DATABASE_URL=postgresql://utilisateur:motdepasse@localhost:5432/nom_de_base

# Google Gemini AI API Key (pour le chatbot intelligent)
GOOGLE_API_KEY=AIzaSy...votre_cle_gemini_ici

# Twilio (pour le chatbot WhatsApp)
TWILIO_ACCOUNT_SID=AC...votre_sid_ici
TWILIO_AUTH_TOKEN=votre_auth_token_ici
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# Azure Storage (optionnel pour les médias)
AZURE_STORAGE_CONNECTION_STRING=""
AZURE_ACCOUNT_NAME="coworkingstorage"
AZURE_CONTAINER="media"

# Cloudinary (optionnel pour les images)
CLOUDINARY_CLOUD_NAME=votre_cloud_name
CLOUDINARY_API_KEY=votre_api_key
CLOUDINARY_API_SECRET=votre_api_secret
